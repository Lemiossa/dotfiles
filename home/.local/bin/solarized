#!/bin/sh
# solarized - toggle the whole desktop between Solarized Dark and Light.
#
# Usage:
#   solarized [dark|light]  apply a specific theme
#   solarized toggle        flip to the other theme
#   solarized rofi          interactive menu (bound to Alt+T)
#   solarized current       print the active theme

set -eu

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
STATE_FILE="$CACHE_DIR/solarized"
VIM_TRIGGER="$CACHE_DIR/theme_reload"
CONF_DIR="$HOME/.config"

usage() {
    cat <<EOF
solarized - toggle the whole desktop between Solarized Dark and Light.

Usage:
  solarized [dark|light]  apply a specific theme
  solarized toggle        flip to the other theme
  solarized rofi          interactive menu (bound to Alt+T)
  solarized current       print the active theme
EOF
}

current() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    else
        echo dark
    fi
}

apply() {
    theme="$1"

    mkdir -p "$CACHE_DIR"

    # state (also read by .vimrc)
    printf '%s\n' "$theme" > "$STATE_FILE"

    # --- X resources (urxvt palette) ---
    if [ -f "$CONF_DIR/solarized/Xresources-$theme" ]; then
        cp -f "$CONF_DIR/solarized/Xresources-$theme" "$HOME/.Xresources"
        if command -v xrdb >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
            xrdb "$HOME/.Xresources"
        fi
    fi

    # --- polybar colors ---
    if [ -f "$CONF_DIR/polybar/colors-$theme.ini" ]; then
        cp -f "$CONF_DIR/polybar/colors-$theme.ini" "$CONF_DIR/polybar/colors.ini"
        if [ -n "${DISPLAY:-}" ] && command -v polybar-msg >/dev/null 2>&1; then
            polybar-msg cmd restart >/dev/null 2>&1 || true
        fi
    fi

    # --- bspwm borders ---
    if command -v bspc >/dev/null 2>&1; then
        if [ "$theme" = dark ]; then
            bspc config normal_border_color  "#586e75" 2>/dev/null || true
        else
            bspc config normal_border_color  "#93a1a1" 2>/dev/null || true
        fi
        bspc config focused_border_color "#268bd2" 2>/dev/null || true
    fi

    # --- GTK dark preference ---
    if [ "$theme" = dark ]; then
        prefer=true
    else
        prefer=false
    fi
    for f in "$CONF_DIR/gtk-3.0/settings.ini" "$CONF_DIR/gtk-4.0/settings.ini"; do
        if [ -f "$f" ]; then
            if grep -q '^gtk-application-prefer-dark-theme=' "$f"; then
                sed -i "s|^gtk-application-prefer-dark-theme=.*|gtk-application-prefer-dark-theme=$prefer|" "$f"
            else
                printf 'gtk-application-prefer-dark-theme=%s\n' "$prefer" >> "$f"
            fi
        fi
    done
    if command -v gsettings >/dev/null 2>&1; then
        if [ "$theme" = dark ]; then
            gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
        else
            gsettings set org.gnome.desktop.interface color-scheme default 2>/dev/null || true
        fi
    fi

    # --- wallpaper ---
    WALL_DIR="$HOME/Pictures/wallpapers"
    if [ "$theme" = dark ]; then
        WALL="$WALL_DIR/solarized_dark_01.png"
    else
        WALL="$WALL_DIR/solarized_light_01.png"
    fi
    if [ -f "$WALL" ]; then
        ln -sf "$WALL" "$HOME/.wallpaper"
        if command -v feh >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
            feh --bg-scale "$HOME/.wallpaper"
        fi
    fi

    # --- vim: reload colorscheme on the next focus ---
    touch "$VIM_TRIGGER"
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

case "$1" in
    dark|light)
        apply "$1"
        ;;
    toggle)
        if [ "$(current)" = light ]; then
            apply dark
        else
            apply light
        fi
        ;;
    rofi)
        if ! command -v rofi >/dev/null 2>&1; then
            echo "rofi is not installed" >&2
            exit 1
        fi
        sel=$(printf '  Solarized Dark\n  Solarized Light\n' |
            rofi -dmenu -p 'Theme' -no-custom) || true
        case "$sel" in
            *Dark)  apply dark ;;
            *Light) apply light ;;
            *)      exit 0 ;;
        esac
        ;;
    current)
        current
        ;;
    *)
        usage
        exit 1
        ;;
esac