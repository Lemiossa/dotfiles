# Configuração de cores do ls - Gruvbox Purple
# Baseado na paleta oficial do Gruvbox com destaque roxo.

TERM *color*
TERM xterm*
TERM screen*
TERM tmux*
TERM alacritty
TERM linux
TERM vt100
TERM ansi
TERM *

# Reset
RESET 0

# Diretórios e links
DIR 01;38;5;175
LINK 01;38;5;109
MULTIHARDLINK 01;38;5;175
SYMLINK 01;38;5;109
ORPHAN 01;38;5;167
MISSING 01;38;5;167

# Tipos especiais
FIFO 38;5;245
SOCK 01;38;5;175
BLK 01;38;5;214
CHR 01;38;5;214
DOOR 01;38;5;175

# Permissões especiais
SUID 37;41
SGID 30;43
STICKY 30;42
OTHER_WRITABLE 34;42
STICKY_OTHER_WRITABLE 37;44
CAPABILITY 30;41

# Arquivos comuns
NORMAL 38;5;223
FILE 38;5;223

