configuration {
    font: "JetBrainsMono 10";
    modi: "drun,run,window";
    show-icons: true;
}

/* Viozene */
* {
    bg:       #15121C;
    bg-alt:   #332F3A;
    fg:       #CAC3D2;
    accent:   #E5C07B;
    urgent:   #E06C75;
    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    width: 40%;
}

mainbox { padding: 12px; }

inputbar {
    background-color: transparent;
    border: 0 0 2px 0;
    border-color: @accent;
    padding: 0 0 8px 0;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; margin: 0 8px 0 0; }
entry { text-color: @fg; placeholder: "buscar..."; }

listview { lines: 8; padding: 8px 0 0 0; }

element { padding: 6px 10px; border-radius: 4px; }
element selected { background-color: @accent; text-color: @bg; }
element urgent { background-color: @urgent; text-color: @bg; }
