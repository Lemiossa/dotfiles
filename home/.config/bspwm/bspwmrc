#!/bin/sh

bspc monitor -d 1 2 3 4 5

# Layout
bspc config border_width          2
bspc config window_gap            12
bspc config split_ratio           0.52
bspc config automatic_scheme      alternate
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focus_follows_pointer true
bspc config pointer_modifier      mod1
bspc config pointer_action1       move
bspc config pointer_action2       resize_corner

# Cores (Gruvbox Purple)
bspc config normal_border_color   "#3C3836"
bspc config active_border_color   "#504945"
bspc config focused_border_color  "#D3869B"
bspc config presel_feedback_color "#B16286"

# Regras
bspc rule -a Gimp state=floating
bspc rule -a Pavucontrol state=floating center=on
bspc rule -a Nm-connection-editor state=floating center=on
bspc rule -a feh state=floating
bspc rule -a Qemu-system-i386 state=floating

# Ambiente
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
xsetroot -cursor_name left_ptr &
setxkbmap br
feh --bg-scale "$HOME/Pictures/Wallpapers/gruvbox-purple.png"

# Servicos (rodados via sh: nao dependem do bit de execucao e,
# se um arquivo faltar, o resto da config do bspwm continua valendo)
for f in "$HOME/.gservices.sh" "$HOME/.config/bspwm/services.sh"; do
    [ -f "$f" ] && sh "$f" &
done
