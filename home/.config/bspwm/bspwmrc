#!/bin/sh

# Appearance values (gaps, border width/colors) come from the appearance module.
. "$HOME/.config/appearance/settings.conf"
. "$HOME/.config/appearance/$DEFAULT_THEME.conf"

bspc monitor -d 1 2 3 4 5

bspc config border_width          "$BORDER_WIDTH"
bspc config window_gap            "$WINDOW_GAP"
bspc config split_ratio           0.5
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focus_follows_pointer true

bspc rule -a Gimp state=floating
bspc rule -a Pavucontrol state=floating
bspc rule -a Nm-connection-editor state=floating
bspc rule -a feh state=floating
bspc rule -a Qemu-system-i386 state=floating

bspc config normal_border_color  "$BORDER_NORMAL"
bspc config focused_border_color "$BORDER_FOCUSED"

# Render and apply the appearance configs (palette, fonts, cursor, wallpaper).
"$HOME/.config/appearance/apply.sh"

# Make sure the root window cursor is the left pointer.
xsetroot -cursor_name left_ptr &

sxhkd &
setxkbmap br
mpd --no-daemon &
dunst &
pipewire &
pipewire-pulse &
wireplumber &
polybar &
# picom &