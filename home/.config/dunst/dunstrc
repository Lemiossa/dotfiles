[global]
    font = JetBrainsMono 10
    format = "<b>%s</b>\n%b"
    width = 300
    height = 100
    offset = 10x40
    transparency = 10
    frame_color = "#514D59"
    separator_color = "#514D59"

[urgency_low]
    background = "#15121C"
    foreground = "#CAC3D2"
    timeout = 5

[urgency_normal]
    background = "#15121C"
    foreground = "#CAC3D2"
    timeout = 8

[urgency_critical]
    background = "#E06C75"
    foreground = "#15121C"
    timeout = 0
