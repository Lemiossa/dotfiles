[global]
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    markup = full
    width = 320
    offset = (12, 48)
    origin = top-right
    padding = 12
    horizontal_padding = 14
    gap_size = 8
    corner_radius = 10
    height = (0, 120)
    frame_width = 2
    frame_color = "#3C3836"
    separator_color = "#3C3836"
    highlight = "#D3869B"
    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "Gruvbox-Plus-Dark"

[urgency_low]
    background = "#282828"
    foreground = "#EBDBB2"
    frame_color = "#FABD2F"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#EBDBB2"
    frame_color = "#D3869B"
    timeout = 8

[urgency_critical]
    background = "#282828"
    foreground = "#FBF1C7"
    frame_color = "#FB4934"
    timeout = 0
